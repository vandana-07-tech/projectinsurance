{
  "name": "insurance-claim-fraud-testing-accelerator",
  "version": "1.0.0",
  "description": "AI-powered insurance API testing platform for life claim business-rule validation",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:sheet": "tsx scripts/generate-fraud-analysis.ts",
    "demo:e2e-sheet": "vitest run tests/requirement-sheet.e2e.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nanoid": "^5.1.0",
    "newman": "^6.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
